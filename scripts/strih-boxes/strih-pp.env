# strih-pp -- the Poprad strih (strih PP), a second Linux strih on the SAME appliance as strih-snv
# (issue 1361; the Poprad rework of 11.10.2026, issue 1412). The box is a desktop: Gigabyte X570,
# Ryzen 7 5800X, RTX 3060 (no iGPU), RTL8125 2.5 GbE PCIe rig NIC; Windows hostname `OBS-PP` before the
# reinstall. Every value below is from the read-only recon of 11.10.2026 (issue 1412 comment
# 6106146258) or an owner ROZHODNUTE on that ticket. A `TODO_OWNER` value is a fact nobody has decided
# yet: setup-strih.sh / verify-strih.sh `--box strih-pp` REFUSE to run while ANY value is TODO_OWNER
# and name each one. Same format + keys as strih-snv.env (see its header).

# The box's own hostname = its fleet name (DNS strih-pp.lan; renamed from OBS-PP at the install).
STRIH_HOSTNAME=strih-pp
# The on-box static /23 address (gateway + DNS 10.77.8.1). dev1 reaches the PP LAN as 10.76.8.0/24
# through the tailscale subnet router companion-pp, so the fleet row dials the NAME strih-pp.lan.
STRIH_IP=10.77.8.202
# = STRIH_HOSTNAME upper-cased (DistroAV prepends the hostname to every NDI output name).
STRIH_NDI_PREFIX=STRIH-PP
# strih-pp is the PP venue NTP master today (ntp_server_mode.enabled=true; stream-pp and resolume-pp
# follow it), so `server`, no upstream.
STRIH_DANTESYNC_ROLE=server
STRIH_DANTESYNC_UPSTREAM=
# The PP intercom hub matrix: the cameras, the phones, the cutters' cans and the vestibule TV (lv1's VBAN
# `strih`). Since 24.10.2026 (issue 1439) the hub forwards nothing into OBS: OBS takes `strih-obs` itself.
STRIH_INTERCOM_CONFIG=intercom.strih-pp.toml
# Issue 1535 (18.11.2026): the rig NIC is the Intel X520-2 (82599ES, 8086:10fb, in-tree ixgbe) from the old
# strih-snv, its SFP+ port 2 (enp5s0f1) at 10 Gb/s on PP's flat network. Its two ports are both ixgbe, so the
# driver match reads MULTI and the rig NIC resolves by STRIH_IP (the NetworkManager profile strih-lan pinned to
# that port). The RTL8125 (r8169, 2.5 GbE, enp6s0 since the card renumbered the bus) is no longer the rig NIC.
STRIH_NIC_DRIVER=ixgbe
# In-tree driver, not a USB device (so no USB speed and no xhci IRQ unit), 10 Gb/s SFP+ link.
STRIH_NIC_OOT_DRIVER=none
STRIH_NIC_MIN_USB_MBPS=none
STRIH_NIC_MIN_LINK_MBPS=10000
# OBS profile + scene-collection names (the strih-snv pattern; the old `strizna-pp` collection is not kept).
STRIH_OBS_PROFILE=strih-pp
STRIH_OBS_COLLECTION=strih-pp
# The cambox the NDI 6.3.2 runtime is copied from. Every cambox carries the same fleet runtime; the
# PP camboxes sit on the PP LAN at 10.77.9.6x (issue 1413), and cam7 (10.77.9.67) is the one that
# answers today. Step 4b only copies when /usr/lib/ndi has no runtime: a box that cannot reach it
# gets the runtime placed first. STRIH_NDI_PEER=<ip> overrides it for one run.
STRIH_NDI_RUNTIME_PEER=10.77.9.67
# The PP Bitfocus Companion controller (companion-pp; strih-pp's Satellite connects to it today).
STRIH_COMPANION_HOST=10.77.8.205
# SongPlayer's program on resolume-pp (the SNV design, owner decision 5.10.2026: no consumer on the cg OBS).
STRIH_CG_SENDER=RESOLUME-PP (SP-program)
# The PP cameras: cam1, cam4, cam6, cam7 (owner ROZHODNUTE 11.10.2026) -> `NDI camN` <- `CAMN (usb)`.
STRIH_CAMERAS=1 4 6 7
# The only GPU is the NVIDIA RTX 3060, whose X driver refuses the RandR lease: vk-direct (desktop
# screen on DisplayPort, output screen on HDMI; owner ROZHODNUTE 11.10.2026: a second monitor).
STRIH_HDMI_OUTPUT_BACKEND=vk-direct
# issue 1412: the cutter role.
STRIH_ROLE=strih
# issue 1536 (18.11.2026, PP's new switch): the Dante GM "dante-ptp" on VLAN 70 (Audinate hardware, PTPv1); the
# flat-LAN GM 10.77.8.110 is gone. The switch also copies its PTP onto the LAN untagged, so dsync stays on the
# rig NIC like SNV (one clock domain at PP). setup writes it only into a FRESH config.json (gm_allowlist); a live
# box's gm_allowlist is the supervisor's edit.
STRIH_DANTE_GM=video-clock.lan
# issue 1553 (owner 25.11.2026): every box allows the name video-clock.lan; the address dev1 grades this
# venue against (none = resolve the name on dev1, which sits on SNV DNS).
STRIH_DANTE_GM_ADDR=10.77.7.200
# The YouTube-guard sampler reads the SNV stream output only.
STRIH_PROGRAM_AUDIO_SAMPLER=off
# issue 1439 phase 2 on strih-pp (design 6385519443, 24.10.2026): lv1 (10.77.8.230) sent the strih program as
# its own VBAN `strih-obs` to 10.77.8.202:6981 (48 kHz, 103 frames, R 40) into the obs-vban source `ASIO zvuk`.
# issue 1536 (18.11.2026, PP's new switch, dasio): the console program comes over Dante now -- dsg (10.77.7.50,
# the SoundGrid<->Dante bridge on VLAN 70, 96 kHz) sends TX 1/2 "STREAM master L/R" -- into the obs release's
# dante_input source (the device strih-obs below), the strih-snv shape, so the VBAN program facts are none and
# the input keeps its name. A VBAN rollback = these three facts back (strih-obs / 6981 / 40) +
# STRIH_DANTE_DEVICES none + the four STRIH_DANTE_* terms none.
STRIH_PROGRAM_VBAN_STREAMS=none
STRIH_PROGRAM_VBAN_PORT=none
STRIH_PROGRAM_VBAN_RESERVE_MS=none
# issue 1462: the OBS program-audio input that source is (the operator collection's name).
STRIH_PROGRAM_AUDIO_INPUT=ASIO zvuk
# issue 1536: the Dante leg = VLAN 70 TAGGED on the rig NIC (the PP switch trunks the port: the rig LAN
# untagged + VLAN 70 tagged, tcpdump -e on enp5s0f1 18.11.2026), 10.77.7.202/24 in table 70 (the Dante variant
# of the leg, dstack's generic filter: it filters only the VLAN interface, never the LAN). The first VLAN on a
# NIC can reset its link for seconds (setup-strih step 13 warns first): create it off production.
STRIH_PROGRAM_VBAN_LEG=vlan:70
STRIH_PROGRAM_VBAN_LEG_ADDR=10.77.7.202
# issue 1519: no VBAN on a Dante leg (dstack's generic filter admits none).
STRIH_PROGRAM_VBAN_SENDER=none
# issue 1536 + intercom#32 (owner: PP at SNV's level): the hub's own device strih-pp-intercom in dstack slot 2
# (never SNV's slot 1; its TOML + subscriptions are the intercom project's) and the OBS program device strih-obs
# in slot 0 like SNV. The site file /etc/camera-box/dante-input.site.conf (never in git) names dsg's channels.
STRIH_DANTE_DEVICES=strih-pp-intercom=4442:8802:4457 strih-obs=4440:8800:4455
# issue 1412: a strih receives no stream program; the PP venue's boxes (strih-pp, stream-pp) list
# each other's STRIH_IP as their NDI senders.
STRIH_PROGRAM_SENDER=none
STRIH_VENUE=pp
# issue 1413: how dev1 dials the PP camboxes (the dantesync fleet's camera rows, `reach`-gated): the PP
# LAN (10.77.8.0/23, the camboxes at 10.77.9.6x) is reached from dev1 as 10.76.x through the
# companion-pp subnet router, so cam N is 10.76.9.<camera_resolve last octet> (cam7 = 10.76.9.67).
STRIH_CAMERA_DEV1_NET=10.76.9
# issue 1399: the TLS front end this box serves itself (see strih-snv.env). interkom-pp moves from
# VDO.Ninja to this box's hub (ROZHODNUTE on issue 1412, 13.10.2026: "prehod to"); its DNS record is a
# supervisor step.
STRIH_HTTPS_INTERKOM_HOSTS=interkom-pp.newlevel.media
STRIH_HTTPS_SHADING_HOST=shadingpp.newlevel.media
# issue 1424 part 2 (owner ROZHODNUTE 13.10.2026): TWO fixed outputs at once -- HDMI-0 = the cutter's
# Multiview (BenQ), HDMI-1 = the Program + its audio for the vestibule (Blackmagic HDMI-to-SDI). These are
# the DEFAULT views: the operator's choice in OBS Tools > HDMI vystup is kept by setup-strih step 6.
# `:noaudio` (issue 1424 part 3): HDMI-1's PCM is owned by the intercom hub, which writes the vestibule
# audio there, so the OBS module opens no audio leg on it.
STRIH_HDMI_OUTPUTS=HDMI-0:multiview HDMI-1:program:noaudio
# issue 1453 (owner 18.10.2026): `yes` = this box publishes its intercom page to phones on MOBILE DATA:
# an outbound Cloudflare Tunnel (cloudflared-interkom.service, token /etc/cloudflared/interkom-tunnel.token)
# carries the page + the Janus WebSocket, Cloudflare TURN (key /etc/intercom-hub/turn.toml) the media; a
# phone on the venue WiFi stays on the LAN. `no` = LAN only. setup-strih step 16i, verify-strih item 45.
STRIH_HTTPS_PUBLIC=yes
# issue 1462: the strih role has no stream Development scene.
STRIH_STREAM_DEV_SCENE=none
# issue 808 (owner ruling 5977504457 + owner 26.10.2026): the shading panel lists this venue's STRIH_CAMERAS, a handheld SBC the control of the
# cambox its video reaches. camN.lan does not resolve on the PP LAN (read 26.10.2026), so every cambox is
# its address. Issue 1537 (owner reversed the 15.11 ruling on 18.11.2026: the Orange handhelds run in PP): cam1 = cam1-shading,
# cam4 (the cable cam) = handheld-1 registering as cam4-shading; cam6/cam7 on their own box relays (REST pin).
STRIH_BKSHADING_RELAYS=1=sbc-relay@register:cam1-shading 4=sbc-relay@register:cam4-shading 6=cambox-relay@10.77.9.66:8771 7=cambox-relay@10.77.9.67:8771
# issue 1425 (design 6443440513): the FIXED OBS audio buffering, ms (0..960). setup-strih step 5 writes it
# to ~/.camera-box/genlock-audio-buffering-ms and libobs holds the mix at it from the first tick, never
# growing it. 0 = the value strih-snv and stream-snv drew on their last 10 launches (27.10.2026); one
# PP/SNV design, this box's own draw is read by verify-strih item 48 after its next OBS start.
STRIH_AUDIO_BUFFERING_MS=0
# issue 1535 (owner 18.11.2026: "Mozes to prepinat"): the PP cameras on the JPEG XS link like SNV (issue
# 1387), N:PORT = port 7000+N. The pin = the SNV value, ROZHODNUTE 6546700019 (the fixed 100 ms grid age:
# pin_for_frames(3, 1, 33.3) = 36), one PP/SNV design. The program to stream-pp follows separately.
STRIH_JXS_CAMERAS=1:7001 4:7004 6:7006 7:7007
STRIH_JXS_CAMERA_PIN_MS=36
STRIH_JXS_PROGRAM_PORT=none
STRIH_JXS_PROGRAM_PIN_MS=none
# issue 1466 (ROZHODNUTE 6737530836, the gradual move to XFCE): the operator desktop session -- openbox (the
# kiosk + tint2) until this box's turn; moving it = xfce here + setup-strih.
STRIH_DESKTOP=openbox
# issues 1510 + 1513 (obs v0.4.27, dstack 244, owner-approved model): the program Dante device's latency as
# NAMED terms, never dlink's hidden default. (a) STRIH_DANTE_NETWORK_LATENCY_MS = Dante Controller's latency
# (0.25 / 0.5 / 1 / 2 / 5), (b) STRIH_DANTE_RECEIVE_BUFFER_MS = this PC's RX room; the Dante latency P = (a) + (b),
# the app hand-off (c) is computed by dlink (.claude/rules/audio-clock-map.md). STRIH_DANTE_TX = none or the two
# labels of the OBS track sent to Dante (`L,R`), STRIH_DANTE_TX_TRACK = that track. Never a raise or a drop
# without the owner (no buffer / latency change without consent); a TX needs (b) set.
# issue 1536: strih-snv's values, 1 + 12.041666 = P 13.041666 ms (the owner-approved model). RX only.
STRIH_DANTE_NETWORK_LATENCY_MS=1
STRIH_DANTE_RECEIVE_BUFFER_MS=12.041666
STRIH_DANTE_TX=none
STRIH_DANTE_TX_TRACK=none
# issue 1425 (obs#96, obs v0.4.61, design 7107436350): the RX hand-off margin -- every RX chunk stamped this
# many ms after dlink's play time, so a chunk handed late still makes OBS's FIXED 0 ms mix; none = no line
# (0 ms), else 0..50. strih-snv 10 (v0.4.61 without it: late_to_mix +60 in 2 h, worst min_lead -7.0 ms).
STRIH_DANTE_RX_STAMP_MARGIN_MS=none
# issue 1502: a stable short rig-NIC name (`<mac>=<name>`, a systemd .link written by setup-strih step 1c)
# or none = the kernel's name. Needed only when `<rig nic>.<vlan id>` would pass 15 characters.
STRIH_NIC_RENAME=none
# issue 1425: the housekeeping CPUs (a cpulist) or none = nothing moved (not measured on this box yet).
STRIH_HOUSEKEEPING_CPUS=none
# issue 1553 (PP switch tail-drops, 25.11.2026): the rig NIC's sender egress pacing -- an fq per tx queue with this
# per-flow maxrate (setup-strih step 11b, verify-strih item 16), none = not paced. One value on every box (SNV = PP).
STRIH_EGRESS_PACING_RATE=900mbit
