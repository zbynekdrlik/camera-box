# strih-pp -- the Poprad strih (strih PP), a second Linux strih on the SAME appliance as strih-lx
# (issue 1361, planned ~7.10.2026). TEMPLATE: every `TODO_OWNER` value is a fact nobody has decided
# yet. setup-strih.sh / verify-strih.sh `--box strih-pp` REFUSE to run while ANY value is
# TODO_OWNER and name each missing fact. Same format + keys as strih-lx.env (see its header).

# The box's own hostname = its fleet name. If it is not `strih-pp`, rename this file to match.
STRIH_HOSTNAME=TODO_OWNER
# The Poprad rig-LAN static IP.
STRIH_IP=TODO_OWNER
# = STRIH_HOSTNAME upper-cased (DistroAV prepends the hostname to every NDI output name).
STRIH_NDI_PREFIX=TODO_OWNER
# dantesync role at the Poprad venue: `server` (this box is the venue NTP master) or `client`
# (then STRIH_DANTESYNC_UPSTREAM = the venue NTP master host).
STRIH_DANTESYNC_ROLE=TODO_OWNER
STRIH_DANTESYNC_UPSTREAM=TODO_OWNER
# The intercom hub routing file for Poprad (interkom-pp runs VDO.Ninja until the Poprad rebuild).
STRIH_INTERCOM_CONFIG=TODO_OWNER
# The kernel driver of the Poprad notebook's rig NDI NIC (read off the hardware on arrival).
STRIH_NIC_DRIVER=TODO_OWNER
# OBS profile + scene-collection names for the Poprad operator.
STRIH_OBS_PROFILE=TODO_OWNER
STRIH_OBS_COLLECTION=TODO_OWNER
# A Poprad cam box to copy the NDI runtime from.
STRIH_NDI_RUNTIME_PEER=TODO_OWNER
# The Poprad Companion controller (or the same one, if it is reachable there).
STRIH_COMPANION_HOST=TODO_OWNER
# The Poprad CG sender (`none` if Poprad has no CG box).
STRIH_CG_SENDER=TODO_OWNER
# The camera numbers that exist in Poprad.
STRIH_CAMERAS=TODO_OWNER
# How the fixed HDMI output leaves the X desktop: lease (an Intel-driven connector) or vk-direct (an
# NVIDIA-driven one) -- read `xrandr --listproviders` / which GPU drives the chosen HDMI port (issue 1346).
STRIH_HDMI_OUTPUT_BACKEND=TODO_OWNER
