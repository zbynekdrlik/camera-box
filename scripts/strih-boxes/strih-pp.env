# strih-pp -- the Poprad strih (strih PP), a second Linux strih on the SAME appliance as strih-snv
# (issue 1361; the Poprad rework of 11.10.2026, issue 1412). The box is a desktop: Gigabyte X570,
# Ryzen 7 5800X, RTX 3060 (no iGPU), RTL8125 2.5 GbE PCIe rig NIC; Windows hostname `OBS-PP` before the
# reinstall. Every value below is from the read-only recon of 11.10.2026 (issue 1412 comment
# 6106146258) or an owner ROZHODNUTE on that ticket. A `TODO_OWNER` value is a fact nobody has decided
# yet: setup-strih.sh / verify-strih.sh `--box strih-pp` REFUSE to run while ANY value is TODO_OWNER
# and name each one. Same format + keys as strih-snv.env (see its header).

# The box's own hostname = its fleet name (DNS strih-pp.lan; renamed from OBS-PP at the install).
STRIH_HOSTNAME=strih-pp
# The on-box static /23 address (gateway + DNS 10.77.8.1). dev1 reaches the PP LAN as 10.76.8.0/24
# through the tailscale subnet router companion-pp, so the fleet row dials the NAME strih-pp.lan.
STRIH_IP=10.77.8.202
# = STRIH_HOSTNAME upper-cased (DistroAV prepends the hostname to every NDI output name).
STRIH_NDI_PREFIX=STRIH-PP
# strih-pp is the PP venue NTP master today (ntp_server_mode.enabled=true; stream-pp and resolume-pp
# follow it), so `server`, no upstream.
STRIH_DANTESYNC_ROLE=server
STRIH_DANTESYNC_UPSTREAM=
# The PP intercom hub matrix: the cameras, the phones, the cutters' cans and the vestibule TV (lv1's VBAN
# `strih`). Since 24.10.2026 (issue 1439) the hub forwards nothing into OBS: OBS takes `strih-obs` itself.
STRIH_INTERCOM_CONFIG=intercom/intercom.strih-pp.toml
# The rig NIC is the RTL8125 on PCIe (10ec:8125), bound by the in-tree r8169. The onboard RTL8168
# (10ec:8168) is r8169 too: disable it in the BIOS, or the driver match reads MULTI and setup asks for
# STRIH_NIC_IFACE=<iface>.
STRIH_NIC_DRIVER=r8169
# In-tree driver, not a USB device (so no USB speed and no xhci IRQ unit), 2.5 Gb/s link (Windows read
# 2.5 Gbps on that NIC).
STRIH_NIC_OOT_DRIVER=none
STRIH_NIC_MIN_USB_MBPS=none
STRIH_NIC_MIN_LINK_MBPS=2500
# OBS profile + scene-collection names (the strih-snv pattern; the old `strizna-pp` collection is not kept).
STRIH_OBS_PROFILE=strih-pp
STRIH_OBS_COLLECTION=strih-pp
# The cambox the NDI 6.3.2 runtime is copied from. Every cambox carries the same fleet runtime; the
# PP camboxes sit on the PP LAN at 10.77.9.6x (issue 1413), and cam7 (10.77.9.67) is the one that
# answers today. Step 4b only copies when /usr/lib/ndi has no runtime: a box that cannot reach it
# gets the runtime placed first. STRIH_NDI_PEER=<ip> overrides it for one run.
STRIH_NDI_RUNTIME_PEER=10.77.9.67
# The PP Bitfocus Companion controller (companion-pp; strih-pp's Satellite connects to it today).
STRIH_COMPANION_HOST=10.77.8.205
# SongPlayer's program on resolume-pp (the SNV design, owner decision 5.10.2026: no consumer on the cg OBS).
STRIH_CG_SENDER=RESOLUME-PP (SP-program)
# The PP cameras: cam1, cam4, cam6, cam7 (owner ROZHODNUTE 11.10.2026) -> `NDI camN` <- `CAMN (usb)`.
STRIH_CAMERAS=1 4 6 7
# The only GPU is the NVIDIA RTX 3060, whose X driver refuses the RandR lease: vk-direct (desktop
# screen on DisplayPort, output screen on HDMI; owner ROZHODNUTE 11.10.2026: a second monitor).
STRIH_HDMI_OUTPUT_BACKEND=vk-direct
# issue 1412: the cutter role.
STRIH_ROLE=strih
# The PP PTP grandmaster (the recon read it as the Dante grandmaster of the PP clock).
STRIH_DANTE_GM=10.77.8.110
# The YouTube-guard sampler reads the SNV stream output only.
STRIH_PROGRAM_AUDIO_SAMPLER=off
# issue 1439 phase 2 on strih-pp (design 6385519443, owner 24.10.2026: "1 pridal som teraz"): lv1
# (10.77.8.230) sends the strih program as its own VBAN stream `strih-obs` to 10.77.8.202:6981 (48 kHz,
# 103 frames per packet, 2 ch, PCM16; tcpdump on strih-pp 24.10.2026 ~16:45, 1847 packets in 4 s) straight
# into the OBS obs-vban source `ASIO zvuk` (the seed switches it, keeping the operator's mixer state). Its
# `strih` stream still goes to :6980 for the intercom hub (the cans + the vestibule). R = 40 ms, the value
# lv1 is proven at on stream-pp (lost 0, about 27 ms spare). That proof is lv1's 256-frame `stream` to
# stream-pp (worst gap 26-29 ms), not this 103-frame `strih-obs`: read its status lines after a production.
STRIH_PROGRAM_VBAN_STREAMS=strih-obs
STRIH_PROGRAM_VBAN_PORT=6981
STRIH_PROGRAM_VBAN_RESERVE_MS=40
# issue 1462: the OBS program-audio input that source is (the operator collection's name).
STRIH_PROGRAM_AUDIO_INPUT=ASIO zvuk
# issue 1439: no VBAN-only leg: lv1 reaches the rig NIC 10.77.8.202 directly, as on stream-pp.
STRIH_PROGRAM_VBAN_LEG=none
STRIH_PROGRAM_VBAN_LEG_ADDR=none
STRIH_PROGRAM_VBAN_SENDER=none
# issue 1412: a strih receives no stream program; the PP venue's boxes (strih-pp, stream-pp) list
# each other's STRIH_IP as their NDI senders.
STRIH_PROGRAM_SENDER=none
STRIH_VENUE=pp
# issue 1413: how dev1 dials the PP camboxes (the dantesync fleet's camera rows, `reach`-gated): the PP
# LAN (10.77.8.0/23, the camboxes at 10.77.9.6x) is reached from dev1 as 10.76.x through the
# companion-pp subnet router, so cam N is 10.76.9.<camera_resolve last octet> (cam7 = 10.76.9.67).
STRIH_CAMERA_DEV1_NET=10.76.9
# issue 1399: the TLS front end this box serves itself (see strih-snv.env). interkom-pp moves from
# VDO.Ninja to this box's hub (ROZHODNUTE on issue 1412, 13.10.2026: "prehod to"); its DNS record is a
# supervisor step.
STRIH_HTTPS_INTERKOM_HOSTS=interkom-pp.newlevel.media
STRIH_HTTPS_SHADING_HOST=shadingpp.newlevel.media
# issue 1424 part 2 (owner ROZHODNUTE 13.10.2026): TWO fixed outputs at once -- HDMI-0 = the cutter's
# Multiview (BenQ), HDMI-1 = the Program + its audio for the vestibule (Blackmagic HDMI-to-SDI). These are
# the DEFAULT views: the operator's choice in OBS Tools > HDMI vystup is kept by setup-strih step 6.
# `:noaudio` (issue 1424 part 3): HDMI-1's PCM is owned by the intercom hub, which writes the vestibule
# audio there, so the OBS module opens no audio leg on it.
STRIH_HDMI_OUTPUTS=HDMI-0:multiview HDMI-1:program:noaudio
# issue 1453 (owner 18.10.2026): `yes` = this box publishes its intercom page to phones on MOBILE DATA:
# an outbound Cloudflare Tunnel (cloudflared-interkom.service, token /etc/cloudflared/interkom-tunnel.token)
# carries the page + the Janus WebSocket, Cloudflare TURN (key /etc/intercom-hub/turn.toml) the media; a
# phone on the venue WiFi stays on the LAN. `no` = LAN only. setup-strih step 16i, verify-strih item 45.
STRIH_HTTPS_PUBLIC=yes
# issue 1462: the strih role has no stream Development scene.
STRIH_STREAM_DEV_SCENE=none
