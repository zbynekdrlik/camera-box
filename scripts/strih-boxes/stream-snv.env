# stream-snv -- the SNV STREAM box, reinstalled from Windows to Linux on 22.10.2026 so SNV runs the
# same setup as PP (owner: "idem prehodit teraz stream-snv na linux aby sme mali rovnaky setup ako v pp").
# It receives the strih-snv program over NDI (and over JPEG XS), takes the program audio from mbc over Dante
# (its own Dante device `stream-obs`, issue 1495, owner 9.11.2026; VBAN `stream` before), and sends RTMP to
# the local restreamer. ONE NIC since issue 1495: the audio VLAN 70 rides tagged on the rig NIC. The box is a laptop: ASUS TUF
# F15 FX507ZV4, i7-12700H, RTX 4060 Laptop (NVENC) + Iris Xe; the rig NIC is a USB 2.5 GbE adapter
# (Realtek RTL8156, issue 1502: lever 3, owner 13.11.2026), renamed rig0. Same format + keys as strih-snv.env (see its header);
# setup-strih.sh / verify-strih.sh --box stream-snv run the stream ROLE (scripts/lib/obs-box-role.sh).

STRIH_HOSTNAME=stream-snv
# The on-box static /23 address on the SNV rig LAN (dev1 reaches it directly).
STRIH_IP=10.77.9.204
STRIH_NDI_PREFIX=STREAM-SNV
# A dantesync client of the SNV NTP master strih-snv.
STRIH_DANTESYNC_ROLE=client
STRIH_DANTESYNC_UPSTREAM=strih-snv.lan
# The pre-issue-1439 program-only hub matrix (mbc's VBAN `stream` -> the strih-program sink -> OBS);
# the stream role installs no hub (setup-strih step 13 moves a present hub aside), the loader only
# shape-checks this fact.
STRIH_INTERCOM_CONFIG=intercom.stream-snv.toml
# issue 1502 (ROZHODNUTE 6849618093, owner 13.11.2026: "na stream-snv dam 2.5g sietovku tak som zapojil tak
# nastav a internu odpojim"): the rig NIC is a USB 2.5 GbE adapter, Realtek RTL8156 (USB 0bda:8156), served by
# the in-tree r8152 (its alias list ends at 8156, issue 1391; stream-pp runs the same chip), on a 5 Gb/s USB
# port at a 2.5 GbE link. Before: the onboard RTL8168 (PCIe, r8169, 1 GbE, enp56s0), whose 1 GbE wire budget
# cost the strih JPEG XS program frames.
STRIH_NIC_DRIVER=r8152
STRIH_NIC_OOT_DRIVER=none
STRIH_NIC_MIN_USB_MBPS=5000
STRIH_NIC_MIN_LINK_MBPS=2500
STRIH_OBS_PROFILE=stream-snv
STRIH_OBS_COLLECTION=stream-snv
# The cambox the NDI 6.3.2 runtime is copied from. Every cambox carries the same fleet runtime; the
# SNV camboxes sit at 10.77.9.6x, and cam2 (10.77.9.62) is the one that answers today. Step 4b only copies when /usr/lib/ndi has no runtime: a box that cannot reach it
# gets the runtime placed first. STRIH_NDI_PEER=<ip> overrides it for one run.
STRIH_NDI_RUNTIME_PEER=10.77.9.62
# companion-snv (the stream role runs no Companion Satellite; the fact stays the venue controller).
STRIH_COMPANION_HOST=10.77.9.205
# A stream box receives no CG source and no camera, and has no fixed HDMI output.
STRIH_CG_SENDER=none
STRIH_CAMERAS=none
STRIH_HDMI_OUTPUT_BACKEND=none
STRIH_ROLE=stream
STRIH_DANTE_GM=video-clock.lan
STRIH_PROGRAM_AUDIO_SAMPLER=off
# issue 1439 (design 6338127636): mbc.lan's VBAN `stream` (24-bit, 239 frames per packet) went straight into
# the OBS obs-vban source on UDP 6980 at a fixed Receive Buffer of 80 ms (mbc's gaps reached 52 ms under the
# 22.10.2026 production load, finding 6348583939). issue 1495 (owner 9.11.2026: "prechod stream na dlink v
# obs"): the program comes over Dante into the obs release's dante_input source (the device stream-obs in
# STRIH_DANTE_DEVICES below), so the three VBAN program facts are none. A rollback to VBAN is these three
# lines (stream / 6980 / 80) + STRIH_DANTE_DEVICES=none + the four STRIH_DANTE_* latency / TX facts at the
# end none + the leg sender below back to 10.77.7.232:6980 (issue 1519).
STRIH_PROGRAM_VBAN_STREAMS=none
STRIH_PROGRAM_VBAN_PORT=none
STRIH_PROGRAM_VBAN_RESERVE_MS=none
# issue 1462: the OBS program-audio input (the SNV stream tooling keys on `mbc`: the measurement-audio
# watchdog's meter, the av-sync dock, rig-mode's MBC_INPUT_NAME). issue 1495 keeps the NAME; the seed only
# switches its kind to dante_input, keeping the operator's mixer state.
STRIH_PROGRAM_AUDIO_INPUT=mbc
# ROZHODNUTE 6360417876 (owner 23.10.2026): the audio-VLAN leg at 10.77.7.204. Until 9.11.2026 it was the
# USB-C r8152 NIC (`mac:00:e0:4c:68:01:85`, enx00e04c680185), which dropped off the USB bus on 8.11.2026
# (issue 1495, ~58 min without program audio). issue 1495 (owner 9.11.2026: "stream nb sa ma prerobit na
# jeden ethernet"): VLAN 70 TAGGED on the rig NIC enp56s0 (r8169; foh2_video ether4: VLAN 89 untagged PVID +
# VLAN 70 tagged, admit-all, set by the supervisor 9.11.2026) = enp56s0.70. setup-strih step 13 creates it,
# reads it back, and only then retires the old NIC leg's profile (scripts/lib/strih-vban-leg.sh).
# issue 1502: the rig NIC is now the USB 2.5 GbE adapter renamed rig0, so the leg is rig0.70.
STRIH_PROGRAM_VBAN_LEG=vlan:70
STRIH_PROGRAM_VBAN_LEG_ADDR=10.77.7.204
# issue 1519: VBAN on the Dante leg is retired (dstack's generic filter admits none): no sender.
STRIH_PROGRAM_VBAN_SENDER=none
# issue 1495: the Dante device on the leg, name=arc:cmc:flows (issue 1519: no RX range; the strih-snv strih-obs shape;
# this box has no hub, so no second device). setup-strih step 13 writes ~/.camera-box/dante-input.toml from
# these ports and the untracked site file /etc/camera-box/dante-input.site.conf (the mbc stream mix's
# transmitter + channels, never in the repo). Declared here = the leg gets the real /24 + these ports through its filter.
STRIH_DANTE_DEVICES=stream-obs=4440:8800:4455
# The strih-snv program this stream box receives (`NDI 2ME PGM`, genlocked).
STRIH_PROGRAM_SENDER=STRIH-SNV (2ME PGM)
STRIH_VENUE=snv
# issue 1413: a stream box lists no camera, so there is no camera network for dev1 to dial.
STRIH_CAMERA_DEV1_NET=none
# issue 1399: a stream box serves no intercom / shading page.
STRIH_HTTPS_INTERKOM_HOSTS=none
STRIH_HTTPS_SHADING_HOST=none
# issue 1424 part 2: no fixed HDMI output (the backend is none).
STRIH_HDMI_OUTPUTS=none
# issue 1453: `no` = this box publishes nothing off the LAN (the stream role serves no intercom page).
STRIH_HTTPS_PUBLIC=no
# issue 1462: the issue-1380 SNV design: Development nests PRO, whose mbc carries the cam2 measurement marker the E2E reads.
STRIH_STREAM_DEV_SCENE=nested-pro
# issue 808: the stream role runs no shading service.
STRIH_BKSHADING_RELAYS=none
# issue 1425 (design 6443440513): the FIXED OBS audio buffering, ms (0..960). setup-strih step 5 writes it
# to ~/.camera-box/genlock-audio-buffering-ms and libobs holds the mix at it from the first tick, never
# growing it. 0 = what this box's last 10 launches drew (live read 27.10.2026 on strih-snv and
# stream-snv: total_buffering=0 ms for the whole run).
STRIH_AUDIO_BUFFERING_MS=0
# issue 1387: the stream role takes no JPEG XS camera.
STRIH_JXS_CAMERAS=none
STRIH_JXS_CAMERA_PIN_MS=none
# issue 1387 (owner decision 6543644987: the production scene PRO on `JXS PGM src`): the UDP port the venue
# strih's program arrives on (its jxs-output.json target = this box's STRIH_IP:PORT) and the input's genlock
# pin = the stream A/V pin (31.10.2026; it is re-measured after the 100 ms step -- a new value is this line).
# 6.11.2026: 1054 -> 1060 -> 1064 = the E2E 42240817752 / 42255481989 recommendations (residuals -14.5 / -11.2 ms vs the -46 ms zero, gain 0.4), issue 1482.
STRIH_JXS_PROGRAM_PORT=7100
STRIH_JXS_PROGRAM_PIN_MS=1064
# issue 1466: the operator desktop session. stream-snv ran xfce from 12.11.2026; the owner rejected it on
# 13.11.2026 ("xdce nepaci sa mi takze vrat stream-snv naspat ten co mame je lepsi"), so it is the openbox kiosk again.
STRIH_DESKTOP=openbox
# issues 1510 + 1513 (obs v0.4.27, dstack 244, owner-approved model): the program Dante device's latency as
# NAMED terms, never dlink's hidden default. (a) STRIH_DANTE_NETWORK_LATENCY_MS = Dante Controller's latency
# (0.25 / 0.5 / 1 / 2 / 5), (b) STRIH_DANTE_RECEIVE_BUFFER_MS = this PC's RX room; the Dante latency P = (a) + (b),
# the app hand-off (c) is computed by dlink (.claude/rules/audio-clock-map.md). STRIH_DANTE_TX = none or the two
# labels of the OBS track sent to Dante (`L,R`), STRIH_DANTE_TX_TRACK = that track. Never a raise or a drop
# without the owner (no buffer / latency change without consent); a TX needs (b) set.
# 1 + 12.041666 = P 13.041666 ms, exactly the RX latency before the named terms (no change). Issue 1513 (owner
# yes, 12.11.2026): the stream OBS program mix (track 1, the YouTube mix) goes to Dante for mbc Live RX 5/6.
# Without (b) the TX would lower P to 8.365 ms. A VBAN rollback (STRIH_DANTE_DEVICES=none) sets all four none.
STRIH_DANTE_NETWORK_LATENCY_MS=1
STRIH_DANTE_RECEIVE_BUFFER_MS=12.041666
STRIH_DANTE_TX=OBS program L,OBS program R
STRIH_DANTE_TX_TRACK=1
# issue 1502: the adapter's predictable name enx00e04c680185 is 15 characters, so its VLAN 70 leg could not
# exist (enx00e04c680185.70 is 18). setup-strih step 1c writes a systemd .link that names it rig0 (rig0.70).
# It is the SAME adapter (same MAC) issue 1495 retired as the old VBAN leg NIC; the switch runbook takes it out
# of that retired-NIC NetworkManager drop-in.
STRIH_NIC_RENAME=00:e0:4c:68:01:85=rig0
