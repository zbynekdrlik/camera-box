# stream-pp -- the Poprad STREAM box (issue 1412, the Poprad rework of 11.10.2026): the stream OBS that
# receives the strih-pp program over NDI, takes the program audio from lv1 over VBAN straight into the
# OBS obs-vban source (issue 1439: no intercom hub, no PipeWire), and sends RTMP to the local restreamer. The box is a
# laptop: Lenovo IdeaPad 82XX, Ryzen 5 7530U, AMD Radeon iGPU only (VAAPI, no NVENC), Realtek USB 2.5 GbE
# rig NIC. Values from the read-only recon of 11.10.2026 (issue 1412 comment 6106146258) + the owner
# rulings on that ticket. Same format + keys as strih-snv.env (see its header); setup-strih.sh /
# verify-strih.sh --box stream-pp run the stream ROLE (scripts/lib/obs-box-role.sh).

STRIH_HOSTNAME=stream-pp
# The on-box static /23 address (dev1 reaches it as 10.76.8.204 through companion-pp).
STRIH_IP=10.77.8.204
STRIH_NDI_PREFIX=STREAM-PP
# A dantesync client of the PP NTP master strih-pp (the recon: client of strih-pp.lan, LOCK).
STRIH_DANTESYNC_ROLE=client
STRIH_DANTESYNC_UPSTREAM=strih-pp.lan
# The pre-issue-1439 program-only hub matrix; the stream role installs no hub any more (setup-strih step 13
# moves a present hub aside), the loader only shape-checks this fact.
STRIH_INTERCOM_CONFIG=intercom.stream-pp.toml
# The Realtek USB 2.5 GbE adapter (RTL8156 class), bound by the in-tree r8152; a USB 3 device.
STRIH_NIC_DRIVER=r8152
STRIH_NIC_OOT_DRIVER=none
STRIH_NIC_MIN_USB_MBPS=5000
STRIH_NIC_MIN_LINK_MBPS=2500
STRIH_OBS_PROFILE=stream-pp
STRIH_OBS_COLLECTION=stream-pp
# The cambox the NDI 6.3.2 runtime is copied from. Every cambox carries the same fleet runtime; the
# PP camboxes sit on the PP LAN at 10.77.9.6x (issue 1413), and cam7 (10.77.9.67) is the one that
# answers today. Step 4b only copies when /usr/lib/ndi has no runtime: a box that cannot reach it
# gets the runtime placed first. STRIH_NDI_PEER=<ip> overrides it for one run.
STRIH_NDI_RUNTIME_PEER=10.77.9.67
# companion-pp (the stream role runs no Companion Satellite; the fact stays the venue controller).
STRIH_COMPANION_HOST=10.77.8.205
# A stream box receives no CG source and no camera, and has no fixed HDMI output.
STRIH_CG_SENDER=none
STRIH_CAMERAS=none
STRIH_HDMI_OUTPUT_BACKEND=none
STRIH_ROLE=stream
# issue 1536 (18.11.2026, PP's new switch): the Dante GM "dante-ptp" on VLAN 70 (Audinate hardware, PTPv1); the
# flat-LAN GM 10.77.8.110 is gone. The switch also copies its PTP onto the LAN untagged, so dsync stays on the
# rig NIC like SNV (one clock domain at PP). setup writes it only into a FRESH config.json (gm_allowlist); a live
# box's gm_allowlist is the supervisor's edit.
STRIH_DANTE_GM=video-clock.lan
# issue 1553 (owner 25.11.2026): every box allows the name video-clock.lan; the address dev1 grades this
# venue against (none = resolve the name on dev1, which sits on SNV DNS).
STRIH_DANTE_GM_ADDR=10.77.7.200
STRIH_PROGRAM_AUDIO_SAMPLER=off
# issue 1439 (design 6338127636): lv1's VBAN `stream` went straight into the OBS obs-vban source on UDP 6980
# (R 40). issue 1536 (18.11.2026, PP's new switch, dasio): the stream program comes over Dante now -- dsg
# (10.77.7.50, VLAN 70) TX 1/2 "STREAM master L/R" -- into the dante_input source (the device stream-obs below),
# the stream-snv shape. A VBAN rollback = these three facts back (stream / 6980 / 40) + STRIH_DANTE_DEVICES none
# + the four STRIH_DANTE_* terms none.
STRIH_PROGRAM_VBAN_STREAMS=none
STRIH_PROGRAM_VBAN_PORT=none
STRIH_PROGRAM_VBAN_RESERVE_MS=none
# issue 1462: the OBS program-audio input that source is (the ported PP collection's name).
STRIH_PROGRAM_AUDIO_INPUT=Zvuk z mixu
# issue 1536: the Dante leg = VLAN 70 TAGGED on the rig NIC (the PP switch trunks the port), 10.77.7.204/24
# in table 70 (dstack's generic filter, the VLAN interface only). Create it off production.
STRIH_PROGRAM_VBAN_LEG=vlan:70
STRIH_PROGRAM_VBAN_LEG_ADDR=10.77.7.204
# issue 1519: no VBAN on a Dante leg.
STRIH_PROGRAM_VBAN_SENDER=none
# issue 1536: the stream program device (dstack: distinct from dsg's own device).
STRIH_DANTE_DEVICES=stream-obs=4440:8800:4455
# The strih-pp program this stream box receives (`NDI 2ME PGM`, genlocked).
STRIH_PROGRAM_SENDER=STRIH-PP (2ME PGM)
STRIH_VENUE=pp
# issue 1413: a stream box lists no camera, so there is no camera network for dev1 to dial.
STRIH_CAMERA_DEV1_NET=none
# issue 1399: a stream box serves no intercom / shading page.
STRIH_HTTPS_INTERKOM_HOSTS=none
STRIH_HTTPS_SHADING_HOST=none
# issue 1424 part 2: no fixed HDMI output (the backend is none).
STRIH_HDMI_OUTPUTS=none
# issue 1453: `no` = this box publishes nothing off the LAN (the stream role serves no intercom page).
STRIH_HTTPS_PUBLIC=no
# issue 1462: the YouTube-safe design (ROZHODNUTE 13.10.2026): the measurement clip under the muted program video.
STRIH_STREAM_DEV_SCENE=clip
# issue 808: the stream role runs no shading service.
STRIH_BKSHADING_RELAYS=none
# issue 1425 (design 6443440513): the FIXED OBS audio buffering, ms (0..960). setup-strih step 5 writes it
# to ~/.camera-box/genlock-audio-buffering-ms and libobs holds the mix at it from the first tick, never
# growing it. 0 = the value strih-snv and stream-snv drew on their last 10 launches (27.10.2026); one
# PP/SNV design, this box's own draw is read by verify-strih item 48 after its next OBS start.
STRIH_AUDIO_BUFFERING_MS=0
# issue 1535 (owner 18.11.2026): the strih-pp PROGRAM over JPEG XS like SNV (issue 1387), port 7100. The pin
# keeps this box's program at the minimum it ran on NDI (`NDI 2ME PGM` genlock_latency_ms_src 3, read
# 18.11.2026): PP aligns A/V by a faster picture, never a delayed sound (the vestibule rule).
STRIH_JXS_CAMERAS=none
STRIH_JXS_CAMERA_PIN_MS=none
STRIH_JXS_PROGRAM_PORT=7100
STRIH_JXS_PROGRAM_PIN_MS=3
# issue 1466 (ROZHODNUTE 6737530836, the gradual move to XFCE): the operator desktop session -- openbox (the
# kiosk + tint2) until this box's turn; moving it = xfce here + setup-strih.
STRIH_DESKTOP=openbox
# issues 1510 + 1513 (obs v0.4.27, dstack 244, owner-approved model): the program Dante device's latency as
# NAMED terms, never dlink's hidden default. (a) STRIH_DANTE_NETWORK_LATENCY_MS = Dante Controller's latency
# (0.25 / 0.5 / 1 / 2 / 5), (b) STRIH_DANTE_RECEIVE_BUFFER_MS = this PC's RX room; the Dante latency P = (a) + (b),
# the app hand-off (c) is computed by dlink (.claude/rules/audio-clock-map.md). STRIH_DANTE_TX = none or the two
# labels of the OBS track sent to Dante (`L,R`), STRIH_DANTE_TX_TRACK = that track. Never a raise or a drop
# without the owner (no buffer / latency change without consent); a TX needs (b) set.
# issue 1536: stream-snv's (a) + (b), 1 + 12.041666 = P 13.041666 ms. RX only: PP has no receiver for a
# program TX (stream-snv sends one to mbc), so no TX.
STRIH_DANTE_NETWORK_LATENCY_MS=1
STRIH_DANTE_RECEIVE_BUFFER_MS=12.041666
STRIH_DANTE_TX=none
STRIH_DANTE_TX_TRACK=none
# issue 1425 (obs#96, obs v0.4.61, design 7107436350): the RX hand-off margin -- every RX chunk stamped this
# many ms after dlink's play time, so a chunk handed late still makes OBS's FIXED 0 ms mix; none = no line
# (0 ms), else 0..50. strih-snv 10 (v0.4.61 without it: late_to_mix +60 in 2 h, worst min_lead -7.0 ms).
STRIH_DANTE_RX_STAMP_MARGIN_MS=none
# issue 1502: a stable short rig-NIC name (`<mac>=<name>`, a systemd .link written by setup-strih step 1c)
# or none = the kernel's name. Needed only when `<rig nic>.<vlan id>` would pass 15 characters.
# issue 1536: the rig NIC is the USB RTL8156 enx6c1ff7618e74 (15 characters), so its VLAN 70 leg could not exist
# (enx6c1ff7618e74.70 is 18): setup-strih step 1c names it rig0 (rig0.70), the stream-snv shape. The live
# rename + profile switch is the supervisor's issue-1502 runbook.
STRIH_NIC_RENAME=6c:1f:f7:61:8e:74=rig0
# issue 1425: the housekeeping CPUs (a cpulist) or none = nothing moved (not measured on this box yet).
STRIH_HOUSEKEEPING_CPUS=none
# issue 1553 (PP switch tail-drops, 25.11.2026): the rig NIC's sender egress pacing -- an fq per tx queue with this
# per-flow maxrate (setup-strih step 11b, verify-strih item 36's line), none = not paced. One value on every box (SNV = PP).
STRIH_EGRESS_PACING_RATE=900mbit
