# stream-pp -- the Poprad STREAM box (issue 1412, the Poprad rework of 11.10.2026): the stream OBS that
# receives the strih-pp program over NDI, takes the program audio from lv1 over VBAN straight into the
# OBS obs-vban source (issue 1439: no intercom hub, no PipeWire), and sends RTMP to the local restreamer. The box is a
# laptop: Lenovo IdeaPad 82XX, Ryzen 5 7530U, AMD Radeon iGPU only (VAAPI, no NVENC), Realtek USB 2.5 GbE
# rig NIC. Values from the read-only recon of 11.10.2026 (issue 1412 comment 6106146258) + the owner
# rulings on that ticket. Same format + keys as strih-snv.env (see its header); setup-strih.sh /
# verify-strih.sh --box stream-pp run the stream ROLE (scripts/lib/obs-box-role.sh).

STRIH_HOSTNAME=stream-pp
# The on-box static /23 address (dev1 reaches it as 10.76.8.204 through companion-pp).
STRIH_IP=10.77.8.204
STRIH_NDI_PREFIX=STREAM-PP
# A dantesync client of the PP NTP master strih-pp (the recon: client of strih-pp.lan, LOCK).
STRIH_DANTESYNC_ROLE=client
STRIH_DANTESYNC_UPSTREAM=strih-pp.lan
# The pre-issue-1439 program-only hub matrix; the stream role installs no hub any more (setup-strih step 13
# moves a present hub aside), the loader only shape-checks this fact.
STRIH_INTERCOM_CONFIG=intercom/intercom.stream-pp.toml
# The Realtek USB 2.5 GbE adapter (RTL8156 class), bound by the in-tree r8152; a USB 3 device.
STRIH_NIC_DRIVER=r8152
STRIH_NIC_OOT_DRIVER=none
STRIH_NIC_MIN_USB_MBPS=5000
STRIH_NIC_MIN_LINK_MBPS=2500
STRIH_OBS_PROFILE=stream-pp
STRIH_OBS_COLLECTION=stream-pp
# The cambox the NDI 6.3.2 runtime is copied from. Every cambox carries the same fleet runtime; the
# PP camboxes sit on the PP LAN at 10.77.9.6x (issue 1413), and cam7 (10.77.9.67) is the one that
# answers today. Step 4b only copies when /usr/lib/ndi has no runtime: a box that cannot reach it
# gets the runtime placed first. STRIH_NDI_PEER=<ip> overrides it for one run.
STRIH_NDI_RUNTIME_PEER=10.77.9.67
# companion-pp (the stream role runs no Companion Satellite; the fact stays the venue controller).
STRIH_COMPANION_HOST=10.77.8.205
# A stream box receives no CG source and no camera, and has no fixed HDMI output.
STRIH_CG_SENDER=none
STRIH_CAMERAS=none
STRIH_HDMI_OUTPUT_BACKEND=none
STRIH_ROLE=stream
STRIH_DANTE_GM=10.77.8.110
STRIH_PROGRAM_AUDIO_SAMPLER=off
# issue 1439 (design 6338127636): lv1's VBAN `stream` goes straight into the OBS obs-vban source on
# UDP 6980 (no intercom hub on the stream role), stamped on the receive timeline with a fixed 40 ms
# Receive Buffer (above lv1's measured worst 10-min gap, 29.1 ms).
STRIH_PROGRAM_VBAN_STREAMS=stream
STRIH_PROGRAM_VBAN_PORT=6980
STRIH_PROGRAM_VBAN_RESERVE_MS=40
# issue 1462: the OBS program-audio input that source is (the ported PP collection's name).
STRIH_PROGRAM_AUDIO_INPUT=Zvuk z mixu
# issue 1439: no VBAN-only leg (only the program VBAN on its own NIC or VLAN, see stream-snv.env).
STRIH_PROGRAM_VBAN_LEG=none
STRIH_PROGRAM_VBAN_LEG_ADDR=none
STRIH_PROGRAM_VBAN_SENDER=none
# The strih-pp program this stream box receives (`NDI 2ME PGM`, genlocked).
STRIH_PROGRAM_SENDER=STRIH-PP (2ME PGM)
STRIH_VENUE=pp
# issue 1413: a stream box lists no camera, so there is no camera network for dev1 to dial.
STRIH_CAMERA_DEV1_NET=none
# issue 1399: a stream box serves no intercom / shading page.
STRIH_HTTPS_INTERKOM_HOSTS=none
STRIH_HTTPS_SHADING_HOST=none
# issue 1424 part 2: no fixed HDMI output (the backend is none).
STRIH_HDMI_OUTPUTS=none
# issue 1453: `no` = this box publishes nothing off the LAN (the stream role serves no intercom page).
STRIH_HTTPS_PUBLIC=no
# issue 1462: the YouTube-safe design (ROZHODNUTE 13.10.2026): the measurement clip under the muted program video.
STRIH_STREAM_DEV_SCENE=clip
# issue 808: the stream role runs no shading service.
STRIH_BKSHADING_RELAYS=none
# issue 1425 (design 6443440513): the FIXED OBS audio buffering, ms (0..960). setup-strih step 5 writes it
# to ~/.camera-box/genlock-audio-buffering-ms and libobs holds the mix at it from the first tick, never
# growing it. 0 = the value strih-snv and stream-snv drew on their last 10 launches (27.10.2026); one
# PP/SNV design, this box's own draw is read by verify-strih item 48 after its next OBS start.
STRIH_AUDIO_BUFFERING_MS=0
