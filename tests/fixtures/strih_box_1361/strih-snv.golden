=== dantesync-unit ===
[Unit]
Description=dsync (PTP/NTP Synchronization)
After=network.target
Wants=network.target

[Service]
# issue 1483: dsync >= 1.30 sends READY=1 only once the boot date is placed (bounded at 30 s), so
# lightdm, ordered After=dsync.service, starts the operator session and OBS on a placed wall.
Type=notify
NotifyAccess=main
TimeoutStartSec=120
ExecStart=/usr/local/bin/dsync --interface enp7s0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
