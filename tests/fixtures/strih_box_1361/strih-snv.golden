=== janus-ws ===
# strih-snv intercom Janus WebSocket transport -- GENERATED by setup-strih.sh (issue 1345 M3a, issue 1453).
# ws BOUND to 127.0.0.1 :8188 (loopback only: phones reach Janus through the intercom hub's /janus relay), NO wss; no admin API.
general: {
    json = "indented"
    ws = true
    ws_port = 8188
    ws_ip = "127.0.0.1"
    wss = false
    admin_ws = false
    admin_wss = false
}
=== openbox-autostart ===
#!/bin/bash
# strih-snv OBS kiosk boot -- WRITTEN BY setup-strih.sh (issue 1357, the shared OBS-box baseline). Do not hand-edit.
sleep 1
PANEL=$(xrandr | awk '/ connected/ && $1 !~ /^HDMI/ {print $1; exit}')
# The notebook panel is the ONLY desktop screen, PINNED to 60 Hz (a notebook panel's --auto can pick
# 144/165 Hz): its own preferred mode first (stream-pp's panel is 1920x1200, a 1080 pin left black
# bars, issue 1412), then 1920x1080@60, --auto only as the last fallback.
if [ -n "$PANEL" ]; then
  PREF=$(xrandr | awk -v p="$PANEL" '$1 == p {f = 1; next} f && /^[^ ]/ {exit} f && /[+]/ {print $1; exit}')
  { [ -n "$PREF" ] && xrandr --output "$PANEL" --primary --mode "$PREF" --rate 60 2>/dev/null; } \
    || xrandr --output "$PANEL" --primary --mode 1920x1080 --rate 60 2>/dev/null \
    || xrandr --output "$PANEL" --primary --auto 2>/dev/null || true
fi
# issue 1346 (owner 24.9.2026): the HDMI output is the in-OBS DRM-lease output (Program / Multiview),
# NEVER the desktop -- every HDMI output stays OFF in X (the lease takes the idle connector).
for PROJ in $(xrandr | awk '$1 ~ /^HDMI/ {print $1}'); do
  xrandr --output "$PROJ" --off 2>/dev/null || true
done
xset s off -dpms s noblank 2>/dev/null || true
rm -rf "$HOME/.config/obs-studio/.sentinel"/* 2>/dev/null || true
systemctl --user import-environment DISPLAY XAUTHORITY || true
systemctl --user start strih-obs.service || true
systemctl --user start strih-bundle-state-server.service || true
systemctl --user start strih-browser-keeper.service || true
systemctl --user start bkshading-panel-app.service || true
systemctl --user start companion-satellite.service || true
systemctl --user start strih-satellite-watch.timer || true
systemctl --user start dsync-tray.service || true
systemctl --user start strih-display-watch.service || true
systemctl --user start dtray.service || true
systemctl --user start intercom-tray.service || true
systemctl --user start obs-box-panel.service || true
