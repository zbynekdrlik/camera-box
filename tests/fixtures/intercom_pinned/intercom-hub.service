[Unit]
Description=strih-snv intercom mix-minus (N-1) hub — VBAN to the camboxes + declared routing (issue 1345)
Documentation=https://github.com/zbynekdrlik/intercom
# Ordered after the network is up so the VBAN receive socket (:6980) binds cleanly.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The hub loads its declarative matrix (generated from the VB-Matrix XML by
# scripts/vbmatrix_to_intercom_toml.py) and fails loud on a malformed TOML or a bind failure.
ExecStart=/usr/local/bin/intercom-hub --config /etc/intercom-hub/intercom.toml
Restart=on-failure
RestartSec=5
# Journal captures the periodic `intercom-hub: status …` line (levels/underruns) a dev1 watchdog reads.
StandardOutput=journal
StandardError=journal
# Production-by-default hardening: the hub needs no root (it binds UDP :6980, the TCP panel port and,
# through the one capability below, the PTP follower's UDP 319; it reads its world-readable config), so run it as a transient dedicated user
# and sandbox it. These directives intentionally do NOT restrict address families / DNS, so the
# VBAN + camN.lan resolution the live bring-up (M1b/M4) exercises is untouched.
DynamicUser=yes
# The hub's own Dante device (intercom#5) keeps what Dante Controller sets (its name, subscriptions,
# latency) in /var/lib/intercom-hub/dlink.toml: under ProtectSystem=strict only a StateDirectory is
# writable. systemd creates it owned by the unit's user (the dynamic one, or the drop-in's User=).
StateDirectory=intercom-hub
# The Janus room secret file is root-owned 0600; DynamicUser cannot read it directly. systemd's
# credential store loads it 0400 owned by the (dynamic) user into $CREDENTIALS_DIRECTORY, which the
# hub prefers over the configured room_secret_file (matrix::resolve_secret_path). The secret VALUE
# never appears here — only the file path (issue 1345 M3 follow-up).
LoadCredential=janus-room.secret:/etc/intercom-hub/janus-room.secret
NoNewPrivileges=true
# The hub's Dante device (intercom#5) follows Dante PTP in process (dlink's dsync-ptp follower), like
# DVS; the dsync service is only its fallback (owner, 4.11.2026, dstack#1). The follower binds
# UDP 319: without this grant dlink logs "dsync's in-process follower did not start ... port 319
# needs CAP_NET_BIND_SERVICE" and runs on the service clock. Ambient, so it holds for the non-root
# User= of setup-strih's drop-in; it is the hub's only capability (SCHED_FIFO and mlockall come from
# the rlimits below, not from capabilities).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# issue 1401 (design 5980775411): the hub's block loop runs on ONE thread, "hub-mix", at SCHED_FIFO
# priority 10, so contention on the box no longer makes it miss ticks (a lost block on every
# output). This grant lets that thread ask for it (sched_setscheduler on itself only; every other
# hub thread stays SCHED_OTHER). Kept in sync with hub/src/mix_thread.rs MIX_RT_PRIORITY
# (a hub test pins it). Without the grant the thread logs one warning and runs SCHED_OTHER. The
# OBS boxes' "rtprio stays OFF" rule (issue 1357) is about OBS's render tick, not this daemon.
LimitRTPRIO=10
# issue 1401 (design 6265012279): on 14.10.2026 stream-pp ran out of memory, the hub's evicted code
# pages stalled the SCHED_FIFO hub-mix thread in page faults (711 lost ticks in 6 s) and a page fault
# in the hub invoked the OOM killer. The hub locks all its memory (mlockall MCL_CURRENT|MCL_FUTURE)
# before it starts hub-mix; this grant lets a non-root hub do that (tens of MB on a 15 GB box: once
# locked, every thread stack is resident whole).
# Without it the hub logs one WARNING, runs unlocked and /api/state reads memory_locked: false.
LimitMEMLOCK=infinity
# The kernel's OOM killer picks a browser source or the control-room Chrome before the interkom.
OOMScoreAdjust=-900
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# issue 1344: setup-strih step 12 ALWAYS installs a drop-in
# (/etc/systemd/system/intercom-hub.service.d/10-local-audio.conf) that OVERRIDES DynamicUser=no +
# User=<operator> + the operator's XDG_RUNTIME_DIR, so the hub's pw-cat program-sink + talkback
# children reach the operator's PipeWire session (DynamicUser cannot traverse the operator's 0700
# /run/user/<uid>). So on a provisioned strih-snv the hub runs as the operator, NOT DynamicUser; this
# base unit's DynamicUser=yes is only the standalone default for a hub run without that drop-in.

[Install]
WantedBy=default.target
