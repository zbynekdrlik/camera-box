[Unit]
# measurement A/V-sync LINE liveness alarm (#813), DEV1-SIDE. ONE gather -> decide -> alert pass,
# bound to the stream's outputActive (an off-air box never pages; a dead line during a live stream
# does). Complements avsync-heartbeat-alert-watchdog.service (staleness-only) -- see
# .claude/rules/avsync-monitoring.md.
Description=camera-box avsync LINE liveness alarm (#813) -- one stream-state-bound gather/decide/alert pass
Documentation=https://github.com/zbynekdrlik/camera-box

[Service]
Type=oneshot
# %h = the installing user's home. Adjust if the checkout lives elsewhere on dev1.
ExecStart=%h/devel/camera-box/scripts/avsync-lineup-alert-watchdog.sh
# One ssh round-trip to the stream box + one obs_phase2.py stream-status OBS-WS read + (only on a
# confirmed ALARM) an airuleset.py notify -- give it room but never hang the timer.
TimeoutStartSec=45
