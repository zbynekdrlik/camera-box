[Unit]
Description=Camera Box - USB Video Capture to NDI
Documentation=https://github.com/zbynekdrlik/camera-box
After=network-online.target avahi-daemon.service
Wants=network-online.target

# #828 — bound ANY runaway restart storm. With Restart=always + RestartSec=3 and no limit, a
# process that keeps exiting restarts every ~3 s forever (cam4 with a missing grabber:
# NRestarts=27719). The no-capture-device case is now handled IN-PROCESS (the binary retries
# slowly instead of exiting — src/no_device.rs), so it no longer feeds this counter at all; this
# limit is a GENEROUS belt-and-braces cap on any OTHER cause (20 starts / 5 min is a genuine
# pathology where restart-looping is not helping). RestartSec=3 (below) stays fast so a genuine
# mid-stream transient still recovers in seconds; StartLimit* are UNIT-level directives (placing
# them in [Service] silently no-ops). No StartLimitAction= is set, so tripping the cap leaves the
# unit in `failed` (deliberate: stop the storm); recovery is manual (`systemctl reset-failed
# camera-box` / reboot) — the dev1-side reachability watchdog alerts on a down box. The self-heal
# restart path (SELF_HEAL_EXIT_CODE) is rate-limited to 1/10 min, far under this 20/5 min cap, so
# it can never trip it.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# #289 — route the USB capture-controller IRQ(s) onto the isolated core before the
# grab starts (best-effort; the leading '-' means a failure never blocks startup).
ExecStartPre=-/usr/local/bin/camera-box --setup-irq-affinity
ExecStart=/usr/local/bin/camera-box
Restart=always
RestartSec=3

# Run with a mild niceness boost for low latency.
Nice=-10

# #289 — belt-and-braces realtime CPU isolation: confine the process to the
# isolated core (isolcpus=3 on the cam-box fleet) so the SCHED_FIFO grab runs on
# the reserved core by default, with no manual taskset. CPUAffinity is a SOFT
# (inherited) mask — NOT a cpuset hard cap — so the per-thread sched_setaffinity
# calls in the binary still succeed: camera-box moves its painter / --display /
# intercom threads OFF onto the general cores (0-2) at thread start, and re-pins
# the capture+emit thread to the /sys-derived isolated core (authoritative — this
# static value just matches the fleet's isolcpus=3).
#
# REALTIME SCHEDULING (issue 899 defect 2): there is deliberately NO process-wide
# `CPUSchedulingPolicy=fifo` here. It used to be — and it applied to the WHOLE
# process, so every thread the binary did NOT re-pin (the tokio runtime workers,
# the NDI SDK internals: ndis:*/disc:*) inherited SCHED_FIFO prio 50 on core 3,
# NOT the SCHED_OTHER the design intended (measured on cam1: 27 FIFO threads on
# core 3). It is now dropped: the process starts SCHED_OTHER and the binary raises
# SCHED_FIFO prio 90 PER THREAD only on the capture+emit hot path
# (src/affinity.rs set_current_thread_realtime, needs CAP_SYS_NICE — granted by the
# fleet's `setcap cap_sys_nice,cap_ipc_lock`). So the reserved core now carries only
# the grab under FIFO; every auxiliary thread stays SCHED_OTHER (idle slack), which
# is finally the true state. On this non-PREEMPT_RT kernel a non-threaded hardirq
# can still preempt the grab; issue 899's capture-IRQ fix (src/affinity.rs
# select_irq_target_cores) routes the xhci IRQ OFF this core on a stock kernel, and
# the remaining PREEMPT_RT/lowlatency kernel path is STAGED in
# docs/runbooks/899-realtime-isolation.md. `Nice=-10` above still gives the
# SCHED_OTHER auxiliaries a mild CFS boost without letting them preempt the FIFO grab.
CPUAffinity=3

# Environment for NDI SDK
Environment=NDI_RUNTIME_DIR_V6=/usr/lib/ndi

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-box

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/
# /proc/irq (#289): ProtectSystem=strict + ReadOnlyPaths=/ make the tree read-only;
# the --setup-irq-affinity ExecStartPre must WRITE /proc/irq/<n>/smp_affinity, so
# grant it RW explicitly (ReadWritePaths wins over ReadOnlyPaths for this subtree).
# /proc/interrupts is only READ, so it needs no grant. Without this the IRQ routing
# would fail EROFS and silently no-op.
ReadWritePaths=/dev /sys /run /proc/irq

# Allow access to video devices
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
