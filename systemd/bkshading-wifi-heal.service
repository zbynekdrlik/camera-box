[Unit]
# One pass of the handheld SBC's WiFi heal (issue 808, design 5972548198): ping the DHCP default
# gateway on wlan0; after 3 consecutive misses `wpa_cli reassociate`, after 3 more restart
# wpa_supplicant@wlan0. Never acts while wpa_state is not COMPLETED; no reboot. Run every 20 s by
# bkshading-wifi-heal.timer. Installed (enable-only, the timer) by
# scripts/bkshading-provision-sbc.sh --install on a board with a wl* interface; a wired cambox
# never gets it.
Description=bkshading handheld WiFi heal - re-join when the gateway stops answering (issue 808)
Documentation=https://github.com/zbynekdrlik/camera-box
After=wpa_supplicant@wlan0.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/bkshading/bkshading-wifi-heal.sh
# Every step of a pass is bounded (scripts/lib/bkshading-sbc-runtime.sh): each wpa_cli /
# journalctl / is-active call 3 s, each systemctl / modprobe call 20 s, the wait for wlan0 15 s.
# The after-read that follows an action takes up to 23 s (the 15 s settle, a 1 s sleep, one more
# 6 s read, 1 s of SECONDS rounding). A reachability pass with a restart: the before read 6 + the
# ping burst ~4 + the restart 20 + the after read 23. The longest is a driver reload (issue 808
# stuck rung): before read 6 + is-active 3 + journal read 3 + stop 20 + journal cursor 3 +
# modprobe -r 20 + modprobe 20 + wlan0 wait 15 + start 20 + after read 23 = 133 s. A test computes
# that from the lib constants and pins it under TimeoutStartSec (the timer never starts a pass
# while one is still running).
# A pass ended in the middle of a reload (the SIGTERM at that timeout) runs a trap that loads the
# module and starts the supplicant: modprobe 20 + wlan0 wait 15 + start 20 = 55 s, inside
# TimeoutStopSec, after which systemd sends SIGKILL.
TimeoutStartSec=150
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bkshading-wifi-heal
