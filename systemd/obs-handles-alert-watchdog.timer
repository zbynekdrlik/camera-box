[Unit]
# Fires the issue-1406 OBS handle-leak check every 5 min (dev1-side), in lockstep with the
# audio-mixer / render-freeze / bundle-state alert timers. The growth arm grades one pass interval,
# so the 5-min cadence is part of its calibration (5,000 handles/h = ~417 per pass); a leak is paged
# after 3 growing passes (~15 min), a ceiling breach after 2.
Description=Run the camera-box OBS handle-leak check every 5 min (issue 1406)
Documentation=https://github.com/zbynekdrlik/camera-box

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=20s
Persistent=false

[Install]
WantedBy=timers.target
