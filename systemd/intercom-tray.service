[Unit]
# issue 1542 (intercom#34) -- the intercom project's tray icon on the STRIH role: its menu opens the hub's
# loopback-only level page (the cutters' headphone level sliders, 127.0.0.1:8791) in Firefox. The program
# is the 7th member of the PINNED intercom hub bundle (scripts/intercom-release.pin), installed to
# /usr/local/bin/intercom-tray by setup-strih.sh step 16d (intercom_tray_install,
# scripts/lib/intercom-tray.sh). Started at login by the kiosk autostart and after strih-obs by the
# strih genlock deploy, never the XDG autostart; graded by verify-strih's (intercom-tray) row.
Description=intercom-tray -- the cutters' level page in the kiosk systray (issue 1542)
Documentation=https://github.com/zbynekdrlik/camera-box
PartOf=graphical-session.target
After=graphical-session.target
# No binary (a failed install) = a clean condition skip, never a restart loop on a missing ExecStart.
ConditionFileIsExecutable=/usr/local/bin/intercom-tray
# The tray exits 1 without a desktop: five failed starts in 5 min and the unit stays failed (no restart
# loop on a box with no session); the next login's autostart start retries.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# The kiosk's plain Xorg session (the strih-obs-start.sh display); GTK reads ~/.Xauthority. One tray per
# session: the program's own lock in XDG_RUNTIME_DIR (a second one exits 0).
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/intercom-tray
# on-failure, not always: the menu's exit item (exit 0) closes the icon until the next login.
Restart=on-failure
RestartSec=10
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intercom-tray

[Install]
# openbox never reaches graphical-session.target: the kiosk openbox autostart STARTS this unit at every
# login (the strih-obs.service pattern); the WantedBy only makes `enable` meaningful.
WantedBy=graphical-session.target
