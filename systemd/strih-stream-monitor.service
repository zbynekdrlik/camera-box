[Unit]
# issue 1436 -- the stream box's headphones play the REAL outgoing stream (owner 15.10.2026: the SNV way,
# one unified PP/SNV design). scripts/strih_stream_monitor.py runs VLC on the restreamer's local RTMP
# (the key setup-strih step 3 writes into the stream OBS profile = the box name = %l), straight to the
# headphone jack's ALSA PCM (resolved by its PCM name), never through PipeWire (issue 1437); issue 1456:
# VLC as on stream-snv, its volume slider the operator's control, the card at 0 dB. Silent while nothing
# is published, retried every 3 s. Installed by setup-strih.sh step 16d on
# the stream role (scripts/lib/strih-session-apps.sh), started at login by the kiosk autostart, graded by
# verify-strih's (stream-monitor) rows.
Description=Stream box headphone monitor -- VLC plays the outgoing RTMP stream to the headphone jack (issues 1436, 1456)
Documentation=https://github.com/zbynekdrlik/camera-box
# issue 1465: After= the target too. A target orders itself after every unit it Wants (the WantedBy link
# below) unless that unit is already After= it; without this line systemd found the login cycle
# "strih-stream-monitor after strih-obs after graphical-session.target after strih-stream-monitor" and
# dropped a job to break it. strih-bundle-state-server.service has the same two-target shape.
After=graphical-session.target strih-obs.service
# Never give up: the operator must hear the stream whenever the session runs.
StartLimitIntervalSec=0

[Service]
Type=simple
# %l = the short hostname (setup step 1 sets it to the box name = the stream key); %t = the user runtime
# dir: the state file verify-strih reads for "last pass recent" + the headphone PCM owner.
ExecStart=/usr/bin/python3 /usr/local/bin/strih_stream_monitor.py --url rtmp://127.0.0.1:1234/live/%l --state-file %t/strih-stream-monitor.json
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strih-stream-monitor

[Install]
# openbox never reaches graphical-session.target: the kiosk openbox autostart STARTS this unit at
# every login (the strih-obs.service pattern); the WantedBy only makes `enable` meaningful.
WantedBy=graphical-session.target
