[Unit]
Description=strih-lx intercom mix-minus (N-1) hub — VBAN to the camboxes + declared routing (issue 1345)
Documentation=https://github.com/zbynekdrlik/camera-box
# Ordered after the network is up so the VBAN receive socket (:6980) binds cleanly.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The hub loads its declarative matrix (generated from the VB-Matrix XML by
# scripts/vbmatrix_to_intercom_toml.py) and fails loud on a malformed TOML or a bind failure.
ExecStart=/usr/local/bin/intercom-hub --config /etc/intercom-hub/intercom.toml
Restart=on-failure
RestartSec=5
# Journal captures the periodic `intercom-hub: status …` line (levels/underruns) a dev1 watchdog reads.
StandardOutput=journal
StandardError=journal
# Production-by-default hardening: the hub needs no root (it binds only the unprivileged UDP :6980
# + TCP panel port and reads its world-readable config), so run it as a transient dedicated user
# and sandbox it. These directives intentionally do NOT restrict address families / DNS, so the
# VBAN + camN.lan resolution the live bring-up (M1b/M4) exercises is untouched.
DynamicUser=yes
# The Janus room secret file is root-owned 0600; DynamicUser cannot read it directly. systemd's
# credential store loads it 0400 owned by the (dynamic) user into $CREDENTIALS_DIRECTORY, which the
# hub prefers over the configured room_secret_file (matrix::resolve_secret_path). The secret VALUE
# never appears here — only the file path (issue 1345 M3 follow-up).
LoadCredential=janus-room.secret:/etc/intercom-hub/janus-room.secret
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# issue 1344: setup-strih step 12 ALWAYS installs a drop-in
# (/etc/systemd/system/intercom-hub.service.d/10-local-audio.conf) that OVERRIDES DynamicUser=no +
# User=<operator> + the operator's XDG_RUNTIME_DIR, so the hub's pw-cat program-sink + talkback
# children reach the operator's PipeWire session (DynamicUser cannot traverse the operator's 0700
# /run/user/<uid>). So on a provisioned strih-lx the hub runs as the operator, NOT DynamicUser; this
# base unit's DynamicUser=yes is only the standalone default for a hub run without that drop-in.

[Install]
WantedBy=default.target
