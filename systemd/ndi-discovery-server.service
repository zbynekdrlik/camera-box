[Unit]
Description=NDI Discovery Server for the camera-box rig (issue 1342) -- unicast NDI source registry on :5959
Documentation=https://github.com/zbynekdrlik/camera-box
After=network-online.target
Wants=network-online.target

# Bound any runaway restart storm (mirrors rig-lease-server.service / camera-box.service #828).
# StartLimit* are UNIT-level directives (placing them in [Service] silently no-ops).
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# The NDI SDK's own Discovery Server binary (the Linux standalone installer
# Install_NDI_Discovery_Server_v6.sh, from ndi.video; it is NOT part of the libndi runtime the
# camboxes copy). The supervisor installs it at %h/.local/bin/ndi-discovery-server -- see
# .claude/rules/ndi-discovery.md "Install on dev1". %h = the installing user's home (newlevel).
# No -bind: the default 0.0.0.0 serves the rig LAN address (10.77.9.200, what every client's
# networks.discovery names) and survives the address appearing late at boot; dev1's LAN firewall
# is already open (see rig-lease-server.README.md). -port 5959 = the SDK default every client
# assumes when networks.discovery carries no port.
ExecStart=%h/.local/bin/ndi-discovery-server -port 5959
# always (not on-failure): the registry must be up whenever dev1 is -- a clean exit is never
# intended. A dead server makes every CONFIGURED sender invisible (senders stop mDNS once a
# discovery server is configured), so it restarts fast.
Restart=always
RestartSec=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ndi-discovery-server

# Security hardening: a network registry that writes nothing to disk.
# VERIFIED-INERT ON DEV1 TODAY (.claude/rules/dev1-systemd-user-unit-hardening.md, issue 1277): as a
# `--user` unit under dev1's kernel policy (`kernel.apparmor_restrict_unprivileged_userns=1`) the
# mount-namespace directives PrivateTmp/ProtectHome are silently SKIPPED -- they are declared intent
# only (correct if this ever becomes a system unit or the policy changes), not active isolation.
# NoNewPrivileges is a per-process prctl and does engage.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only

[Install]
WantedBy=default.target
