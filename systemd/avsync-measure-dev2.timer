[Unit]
# Fires the dev2 lipsync measurement every ~90 s (#1331), matching avsync-watchdog.ps1's own natural
# cadence. OnUnitInactiveSec (not OnUnitActiveSec) so the next pass starts 90 s AFTER the previous
# one FINISHES -- a variable-length SyncNet run can never overlap itself.
Description=Run the camera-box dev2 lipsync measurement every ~90 s (#1331)
Documentation=https://github.com/zbynekdrlik/camera-box

[Timer]
OnBootSec=1min
OnUnitInactiveSec=90s
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
