[Unit]
# issue 1404: the stream program-audio sampler, DEV1-SIDE, --user. Receives the stream program's
# audio (stream OBS's NDI program output "STREAM-SNV (stream)", audio-only, read-only -- a receiver
# like any NDI monitor) and every 2 s rewrites program-audio.json in the rig-lease server's serve dir
# with a MEASUREMENT | FOREIGN | SILENT | UNKNOWN verdict, served at http://dev1:8890/program-audio.json
# and read by scripts/program_audio_guard.py (the YouTube channel guard). Logs only verdict changes +
# a 10-minute summary. SHIPS DISABLED; runbook: program-audio-sampler.README.md.
Description=camera-box stream program-audio sampler (issue 1404) — NDI audio-only -> :8890/program-audio.json
Documentation=https://github.com/zbynekdrlik/camera-box
After=network-online.target
Wants=network-online.target
# Bound a restart storm (libndi missing, the serve dir unwritable): 20 starts per 5 min.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# %h = the installing user's home on dev1 (newlevel); numpy comes from that user's site-packages.
ExecStart=/usr/bin/python3 %h/devel/camera-box/scripts/program_audio_sampler.py
Restart=on-failure
RestartSec=10
# Optional overrides: PROGRAM_AUDIO_SOURCE (the NDI sender name), RIG_LEASE_SERVE_DIR, NDI_LIB_PATH,
# QPSK_GUARD_SHIM (the marker decoder library; default ~/.local/lib/camera-box/libqpsk-guard-shim.so,
# built by scripts/build-qpsk-guard-shim.sh -- without it the sampler writes UNKNOWN and exits 1).
# A private file, never the GLOBAL ~/.config/environment.d/. The sampler runs its receiver with a
# private, empty NDI_CONFIG_DIR itself: mDNS only, no TCP discovery connection into any sender
# (.claude/rules/ndi-discovery.md, issue 1389).
EnvironmentFile=-%h/.config/camera-box/program-audio-sampler.env
# CPU priority (design issue 1404 comment 6037613222). The sampler's capture thread must call the NDI
# capture at least every ~1.3 s (the SDK drops older audio), so the unit must never lose the CPU to
# the worktree lanes that share the user's app.slice: CPUWeight=1000 gives its cgroup 10x the default
# weight there (systemd enables the cpu controller in app.slice for it). There is NO Nice=: a --user
# unit cannot lower it on dev1 (RLIMIT_NICE 0, systemd runs Nice=-5 at 0 without an error), and the old
# Nice=10 put the sampler behind every lane in the flat app.slice. The sampler logs one start line
# with its nice and cpu.weight (a WARNING while the nice is not below 0).
CPUWeight=1000
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=program-audio-sampler

[Install]
WantedBy=default.target
