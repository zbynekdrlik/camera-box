[Unit]
Description=strih-lx: host OBS projector windows in a child X window (XWayland+NVIDIA PRIME present stall workaround)
After=graphical-session.target
[Service]
Environment=DISPLAY=:0
ExecStart=/bin/sh -c 'export XAUTHORITY=$(ls /run/user/1000/.mutter-Xwaylandauth.* | head -1); exec /usr/local/bin/strih-mv-host.py'
Restart=always
RestartSec=2
[Install]
WantedBy=default.target
