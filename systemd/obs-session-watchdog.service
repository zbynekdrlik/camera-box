[Unit]
# Operator-visibility watchdog (#979/#977/#958; issue 1474). ONE measure -> decide -> alert pass over
# the obs-fleet `obs-session` facet: strih-snv + stream-snv (Linux: strih-obs.service over plain ssh +
# an obs-websocket round-trip) and resolume when home (Windows: the obs64/AHK session-0 probe).
# SHIPS DISABLED -- installed/enabled/live-verified by the supervisor only. See the README.
Description=camera-box obs64/AHK session-visibility watchdog (#979) -- one measure/decide/alert pass
Documentation=https://github.com/zbynekdrlik/camera-box

[Service]
Type=oneshot
# %h = the installing user's home. Adjust if the checkout lives elsewhere on dev1.
ExecStart=%h/devel/camera-box/scripts/obs-session-watchdog.sh
# Per Linux box: the ssh probe (OBS_SESSION_LINUX_SSH_TIMEOUT 20 s) + the obs-websocket round-trip
# (STRIH_LX_WS_TIMEOUT 20 s); plus one win_ssh_run round trip for resolume. Two hung Linux boxes =
# 80 s before resolume, so 150 s; never hang the timer. A changed unit must be reinstalled on dev1.
TimeoutStartSec=150
# stream/resolume ssh creds (targets.md "SSH: newlevel/newlevel") default in-script; override via:
#   Environment=RESOLUME_SNV_PW=...
#   Environment=STREAM_SNV_PW=...
# (issue 1414: the box names are stream-snv / resolume-snv, so the old STREAM_PW / RESOLUME_PW names
# are no longer read by this watchdog.)
