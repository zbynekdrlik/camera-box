[Unit]
# Fires the issue-1404 cam2 marker-log mirror every 10 s (dev1-side). AccuracySec=1s is required: the
# timer default (1 min) would coalesce a 10 s cadence into one pass a minute. SHIPS DISABLED (no
# setup-*.sh turns it on); the supervisor installs it on dev1 per rig-marker-mirror.README.md.
Description=Mirror cam2's QPSK marker log to dev1 :8890 every 10 s (issue 1404)
Documentation=https://github.com/zbynekdrlik/camera-box

[Timer]
# OnUnitActiveSec alone never fires before the service ran once: OnActiveSec starts the chain.
OnActiveSec=5s
OnUnitActiveSec=10s
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
