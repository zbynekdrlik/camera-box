[Unit]
# camera-box: pace this cambox's NDI egress at boot (issue 1242).
# All seven cameras hand their frame to NDI on the same genlock grid instant, so their line-rate
# bursts arrive at strih-lx together and its USB NIC answers with PAUSE storms. An fq root qdisc
# with a per-flow maxrate spreads each camera's already-encoded frame over ~7 ms; fq keeps
# dantesync's PTP/NTP and the intercom as their own flows, never queued behind a video frame.
#
# ExecStart runs the script setup-device.sh GENERATES from scripts/lib/cambox-egress-pacing.sh (the
# ONE declaration of the rate and limits -- the appliance has no checkout of this repo). It resolves
# the default-route interface at run time and retries for ~60 s when the route comes up late, then
# fails LOUD. A box that boots before its switch port has carrier fails that whole round, so the
# unit restarts on failure and never gives up: the pacing lands once the default route appears.
# Installed + ENABLED by setup-device.sh, never started by it; verify-device.sh (ap) proves it after
# the reboot.
Description=camera-box: pace the NDI egress (fq maxrate) on the default-route interface (issue 1242)
Documentation=https://github.com/zbynekdrlik/camera-box/issues/1242
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cambox-egress-pacing
# Above the script's own ~60 s retry, so the loud FAILED line is the script's, never a kill.
TimeoutStartSec=120
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
