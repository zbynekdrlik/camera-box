[Unit]
# Fires the #794 non-60 source-cadence alert every 5 min (dev1-side), matching the network-reach /
# frozen-input / bundle-state alert cadence so the fleet's dev1 alert timers stay in lockstep. The
# rate is measured across the two sampled audit lines' OWN timestamps (never a wall-clock divisor —
# the issue-797 phantom-50 avoidance), so at the 5-min cadence each pass spans ~60 audit ticks: a
# sustained wrong cadence pages within ~10-15 min of onset (2-pass confirm), then re-alerts ~every
# 30 min while it persists, with a one-shot recovery ping on clear.
Description=Run the camera-box non-60 source-cadence alert every 5 min (#794)
Documentation=https://github.com/zbynekdrlik/camera-box

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
AccuracySec=20s
Persistent=false

[Install]
WantedBy=timers.target
